# Скопируйте в .env (или положите в ~/.hermes/.env) и заполните своими значениями.
# Ничего из этого коммитить в git нельзя.

# Ключ API сервера Hermes (обязателен, если сервер Hermes требует авторизацию)
API_SERVER_KEY=

# URL чат-эндпоинта Hermes, с которым общается аватар
HERMES_URL=http://127.0.0.1:8642/v1/chat/completions

# Порт локального сервера аватара (aiohttp)
AVATAR_PORT=8765

# HTML-страница рендера, которую открывает run.sh / Electron
AVATAR_PAGE=toon.html

# Стиль рендера в Electron: ascii (зелёная ASCII-«Матрица» во весь экран) | pbr (прозрачный 3D)
AVATAR_STYLE=ascii

# TTS-движок: silero | piper | edge
TTS_ENGINE=silero
AVATAR_VOICE=ru-RU-DmitryNeural
AVATAR_PIPER=ru_RU-dmitri-medium
AVATAR_SILERO=aidar

# STT (faster-whisper): модель на GPU и на CPU-фоллбэке
AVATAR_WHISPER=large-v3-turbo
AVATAR_WHISPER_CPU=small

# Визуальный эффект фона/пресет
AVATAR_FX=bass

# Устройство записи для скриптов тестов качества речи (proofs/stage56)
WER_CAPTURE_DEVICE=alsa_input.pci-0000_00_1f.3.analog-stereo
